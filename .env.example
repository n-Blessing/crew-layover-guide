# Defaults live in sanity.shared.mjs (project p4yybrla, dataset production).
# Copy this file to .env only if you need to point at a different project.
# Do not commit .env. Do not put a token in this file.

# Astro. PUBLIC_ values are visible in the browser. They are not secrets.
PUBLIC_SANITY_PROJECT_ID=p4yybrla
PUBLIC_SANITY_DATASET=production

# Sanity Studio and the Sanity CLI. Use the same project id and dataset as above.
# Never put a token in a SANITY_STUDIO_ variable. Studio inlines those values into its JavaScript.
SANITY_STUDIO_PROJECT_ID=p4yybrla
SANITY_STUDIO_DATASET=production

# Optional. Only for a private dataset, and only at build time on the server.
# Do not prefix this with PUBLIC_ or SANITY_STUDIO_. Leave it unset for this public dataset.
# SANITY_API_READ_TOKEN=

# Crew Help does not call a model. Do not add an API key for it.
