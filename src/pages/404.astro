---
import BaseLayout from '../layouts/BaseLayout.astro'

const base = import.meta.env.BASE_URL
---

<BaseLayout title="Page not found" description="That page is not part of Crew Layover Guide.">
  <section class="hero-copy">
    <p class="kicker">404</p>
    <h1>That page is not on this route</h1>
    <p class="lede">The city list is the place to start. Studio lives at https://crew-layover-guide.sanity.studio/.</p>
    <p><a class="back-link" href={base}>Back to cities</a></p>
  </section>
</BaseLayout>
